# MediMind AI Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL (for production)
VITE_API_URL=https://your-backend-url.vercel.app

# AI Service Configuration
VITE_AI_PROVIDER=mock
# VITE_AI_PROVIDER=openai
# VITE_OPENAI_API_KEY=your-openai-api-key
# VITE_OPENAI_MODEL=gpt-4

# ============================================================================
# Database Configuration (if using Supabase)
# ============================================================================

# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================================
# Authentication
# ============================================================================

# JWT Secret (for backend)
# JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration
# JWT_EXPIRES_IN=7d

# ============================================================================
# Security
# ============================================================================

# Encryption Key (for backend)
# ENCRYPTION_KEY=your-encryption-key-change-in-production

# Bcrypt Rounds (for backend)
# BCRYPT_ROUNDS=10

# ============================================================================
# Rate Limiting
# ============================================================================

# Rate Limit Window (milliseconds)
# RATE_LIMIT_WINDOW_MS=900000

# Rate Limit Max Requests
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Logging
# ============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# Application Settings
# ============================================================================

# Default Language (en or ur)
VITE_DEFAULT_LANGUAGE=en

# Application Name
VITE_APP_NAME=MediMind AI

# ============================================================================
# File Upload
# ============================================================================

# Max File Size (bytes)
VITE_MAX_FILE_SIZE=10485760

# Allowed File Types
VITE_ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/webp

# ============================================================================
# CORS Configuration (for backend)
# ============================================================================

# CORS Origin
# CORS_ORIGIN=https://your-frontend-url.vercel.app

# ============================================================================
# Email Configuration (for backend, if needed)
# ============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================================================
# Notes
# ============================================================================

# 1. Never commit .env files to git
# 2. Use Vercel's environment variables in production
# 3. Frontend variables must start with VITE_ to be accessible
# 4. Backend variables are set in Vercel dashboard or .env file
# 5. For local development, copy this file to .env and fill in values
